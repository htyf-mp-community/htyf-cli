{
  "name": "@htyf-mp/taro-rn",
  "version": "0.4.9",
  "description": "Taro RN framework",
  "author": "O2Team",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "src",
    "types",
    "apiList.js",
    "libList.js"
  ],
  "scripts": {
    "prod": "pnpm run build",
    "assets": "cpy 'src/**/*.png' '!src/__tests__/*' dist",
    "prebuild": "pnpm run clean",
    "clean": "rimraf ./dist apiList.js libList.js",
    "build": "pnpm --filter @htyf-mp/taro-runtime-rn run build && tsc && pnpm run assets && pnpm run script",
    "dev": "pnpm run assets && tsc --watch",
    "lint": "eslint src script __tests__ --ext .js,.jsx.ts,.tsx",
    "test": "jest --silent",
    "test:ci": "jest --ci -i --coverage --silent",
    "test:coverage": "jest --coverage",
    "test:dev": "jest --watch",
    "script": "node ./script"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NervJS/taro.git"
  },
  "keywords": [
    "taro"
  ],
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@htyf-mp/taro-runtime-rn": "workspace:*",
    "@tarojs/taro": "4.2.0",
    "base64-js": "1.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/parser": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/traverse": "^7.24.4",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-camera-roll/camera-roll": "7.10.2",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/babel-preset": "^0.73.18",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^12.4.1",
    "cpy-cli": "^5.0.0",
    "dpdm": "^3.14.0",
    "expo": "57.0.6",
    "expo-audio": "57.0.2",
    "expo-brightness": "57.0.1",
    "expo-camera": "57.0.2",
    "expo-file-system": "57.0.1",
    "expo-image-manipulator": "57.0.4",
    "expo-image-picker": "57.0.4",
    "expo-keep-awake": "57.0.1",
    "expo-location": "57.0.4",
    "expo-sensors": "57.0.2",
    "jest-expo": "57.0.2",
    "mock-socket": "^7.1.0",
    "react-native": "0.86.0",
    "react-native-device-info": "15.0.2",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-nitro-geolocation": "1.4.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-root-siblings": "5.0.1",
    "react-native-safe-area-context": "5.8.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-camera-roll/camera-roll": "7.10.2",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "57.0.6",
    "expo-audio": "57.0.2",
    "expo-brightness": "57.0.1",
    "expo-camera": "57.0.2",
    "expo-file-system": "57.0.1",
    "expo-image-manipulator": "57.0.4",
    "expo-image-picker": "57.0.4",
    "expo-keep-awake": "57.0.1",
    "expo-location": "57.0.4",
    "expo-sensors": "57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-device-info": "15.0.2",
    "react-native-image-zoom-viewer": "3.0.1",
    "react-native-nitro-geolocation": "1.4.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-root-siblings": "5.0.1",
    "react-native-safe-area-context": "5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
