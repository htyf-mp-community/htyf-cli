{
  "extends": "../../tsconfig.root.json",
  "compilerOptions": {
    // 临时
    "noEmitOnError": false,
    "skipLibCheck": true,
    "checkJs": false,
    
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "jsx": "react",
    "lib": ["ESNEXT"],
    "paths": {
      "@tarojs/runtime": ["./types/runtime.d.ts"],
      "vue": ["./src/types/vue/index.d.ts"]
    },
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["./src", "./types", "__tests__"],
  "exclude": ["__tests__/**"]
}
