{
  // "extends": "../../tsconfig.root.json",
  "compilerOptions": {
    // 临时
    "noEmitOnError": false,
    "skipLibCheck": true,
    "checkJs": false,
    
    "target": "ES2017",
    "module": "commonjs",
    "outDir": "dist",
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "rootDir": "./src"
  },
  "include": ["./src"]
}
