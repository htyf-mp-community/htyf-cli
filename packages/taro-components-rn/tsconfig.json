{
  "extends": "../../tsconfig.root.json",
  "compilerOptions": {
    "declaration": true,
    // 临时
    "noEmitOnError": false,
    "skipLibCheck": true,
    "checkJs": false,
    
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ESNEXT"],
    "types": ["react-native", "jest"]
  },
  "include": ["./src", "types"],
  "exclude": ["./src/__tests__/**", "./src/setup.ts"]
}
