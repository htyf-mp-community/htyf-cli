{
  "name": "@htyf-mp/taro-components-rn",
  "version": "0.3.12-alpha.6",
  "description": "React Native 基础组件",
  "author": "O2Team",
  "license": "MIT",
  "main": "./dist/index.js",
  "scripts": {
    "prod": "pnpm run build",
    "assets": "cpy 'src/**/*.png' '!src/__tests__/*' dist",
    "prebuild": "pnpm run clean",
    "clean": "rimraf ./dist",
    "build": "tsc && pnpm run assets",
    "dev": "pnpm run assets && tsc --watch",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "test": "jest --silent",
    "test:ci": "jest --ci -i --coverage --silent",
    "test:dev": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NervJS/taro.git"
  },
  "keywords": [
    "taro"
  ],
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@ant-design/react-native": "5.4.3",
    "@htyf-mp/taro-router-rn": "workspace:*",
    "@tarojs/components": "4.2.0",
    "prop-types": "15.8.1",
    "react-native-maps": "1.29.0"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-env": "7.29.7",
    "@react-native-community/slider": "5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-native/babel-preset": "0.73.18",
    "@testing-library/jest-native": "5.4.2",
    "@testing-library/react-native": "12.4.1",
    "cpy-cli": "5.0.0",
    "dpdm": "3.14.0",
    "expo": "57.0.6",
    "expo-camera": "57.0.2",
    "expo-module-scripts": "3.5.1",
    "expo-video": "57.0.1",
    "jest-expo": "57.0.2",
    "react-native": "0.86.0",
    "react-native-pager-view": "8.0.4",
    "react-native-svg": "15.15.5",
    "react-native-webview": "14.0.1"
  },
  "peerDependencies": {
    "@react-native-community/slider": "5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "expo": "57.0.6",
    "expo-camera": "57.0.2",
    "expo-video": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-pager-view": "8.0.4",
    "react-native-svg": "15.15.5",
    "react-native-webview": "14.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
