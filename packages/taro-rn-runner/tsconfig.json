{
  // "extends": "../../tsconfig.root.json",
  "compilerOptions": {
    "declaration": true,
    // 临时
    "noEmitOnError": false,
    "skipLibCheck": true,
    "checkJs": false,

    "jsx": "react",
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "inlineSources": true,
    "noUnusedLocals": false,
    "module": "commonjs"
  },
  "include": ["./src"]
}
